; AutoHotkey skript pro Button Box (7 tlačítek)
; Zkratky odpovídají vysílaným kódům z Raspberry Pi Pico W

^F13:: Run "spotify.exe"                ; Tlačítko 1: Spotify
^F14:: Run "brave.exe"                  ; Tlačítko 2: Prohlížeč Brave
^F15:: Run "code"                       ; Tlačítko 3: Visual Studio Code
^F16:: Run "Resolve.exe"                ; Tlačítko 4: DaVinci Resolve
^F17:: Run "lightroom.exe"              ; Tlačítko 5: Adobe Lightroom
^F18:: Run "outlook.exe"                ; Tlačítko 6: Outlook
^F19:: Run "localsend_app.exe"          ; Tlačítko 7: LocalSend
